---
layout: null
permalink: /blog/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Takuya Koriyama — Research blog</title>
    <link>{{ '/blog/' | absolute_url | xml_escape }}</link>
    <description>Notes on statistics, machine learning, and probability.</description>
    <atom:link href="{{ '/blog/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% assign notes = site.research_blog | where: 'published', true | sort: 'date' | reverse %}
    {% for note in notes limit:20 %}
    <item>
      <title>{{ note.title | xml_escape }}</title>
      <link>{{ note.url | absolute_url | xml_escape }}</link>
      <guid isPermaLink="true">{{ note.url | absolute_url | xml_escape }}</guid>
      <pubDate>{{ note.date | date_to_rfc822 }}</pubDate>
      <description>{{ note.description | default: note.excerpt | strip_html | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
